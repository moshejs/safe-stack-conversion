{
  "name": "safe-stack-conversion",
  "version": "1.0.0",
  "description": "Convert a stack of YC SAFEs (post-money & pre-money) and convertible notes into a pro-forma cap table at a priced round — fixed-point solve, cap/discount best-price, interest accrual. Zero dependencies.",
  "keywords": ["safe", "yc-safe", "convertible-note", "cap-table", "startup", "fundraising", "post-money", "valuation-cap", "dilution", "equity", "venture-capital"],
  "homepage": "https://moshemalka.com",
  "repository": { "type": "git", "url": "git+https://github.com/moshejs/safe-stack-conversion.git" },
  "bugs": "https://github.com/moshejs/safe-stack-conversion/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": { "tsup": "^8.5.0", "typescript": "^5.8.0", "vitest": "^3.2.0" },
  "engines": { "node": ">=18" }
}
